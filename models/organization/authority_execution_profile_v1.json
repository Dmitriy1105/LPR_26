{
  "version": "1.1",
  "allowed_inputs": {
    "technical_expertise": [
      "actor",
      "initiator",
      "requirementsMet",
      "remediable"
    ],
    "deal_approval": [
      "actor",
      "initiator",
      "requirementsMet",
      "revisionAllowed"
    ],
    "budget_approval": [
      "actor",
      "initiator",
      "amount",
      "as_of",
      "fundsAvailable"
    ],
    "budget_escalation_universal": [
      "actor",
      "initiator",
      "amount",
      "as_of",
      "fundsAvailable"
    ],
    "corporate_multilevel_universal": [
      "technicalActor",
      "budgetActor",
      "dealActor",
      "initiator",
      "amount",
      "as_of",
      "fundsAvailable",
      "technicalRequirementsMet",
      "remediable"
    ]
  },
  "role_policies": {
    "technical_authority": {
      "output": "competent",
      "field": "competencies",
      "capability": "technical.assess"
    },
    "deal_authority": {
      "output": "authorized",
      "field": "grants",
      "capability": "deal.approve"
    }
  },
  "registry_overrides": {
    "deal_approval": {
      "before": {
        "decide": [
          "deal_authority"
        ]
      }
    },
    "budget_approval": {
      "before": {
        "decide": [
          "budget_authority"
        ]
      }
    },
    "technical_expertise": {
      "before": {
        "assess": [
          "technical_authority"
        ]
      }
    },
    "budget_escalation_universal": {
      "calls": {
        "assess": {
          "process": "budget_approval",
          "inputs": {
            "fundsAvailable": {
              "ref": "fundsAvailable"
            },
            "actor": {
              "ref": "actor"
            },
            "amount": {
              "ref": "amount"
            },
            "as_of": {
              "ref": "as_of"
            },
            "initiator": {
              "ref": "initiator"
            }
          },
          "outputs": {
            "budgetStatus": {
              "ref": "end"
            }
          }
        }
      }
    },
    "corporate_multilevel_universal": {
      "calls": {
        "technical": {
          "process": "technical_expertise",
          "inputs": {
            "requirementsMet": {
              "ref": "technicalRequirementsMet"
            },
            "remediable": {
              "ref": "remediable"
            },
            "actor": {
              "ref": "technicalActor"
            },
            "initiator": {
              "ref": "initiator"
            }
          },
          "outputs": {
            "technicalStatus": {
              "ref": "end"
            }
          }
        },
        "budget": {
          "process": "budget_escalation_universal",
          "inputs": {
            "amount": {
              "ref": "amount"
            },
            "fundsAvailable": {
              "ref": "fundsAvailable"
            },
            "as_of": {
              "ref": "as_of"
            },
            "initiator": {
              "ref": "initiator"
            },
            "actor": {
              "ref": "budgetActor"
            }
          },
          "outputs": {
            "budgetStatus": {
              "ref": "budgetStatus"
            }
          }
        },
        "deal": {
          "process": "deal_approval",
          "inputs": {
            "requirementsMet": {
              "equals": {
                "ref": "readiness",
                "literal": "ready"
              }
            },
            "revisionAllowed": {
              "literal": false
            },
            "actor": {
              "ref": "dealActor"
            },
            "initiator": {
              "ref": "initiator"
            }
          },
          "outputs": {
            "dealOutcome": {
              "ref": "outcome"
            }
          }
        }
      }
    }
  }
}